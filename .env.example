BOT_TOKEN=123456789:replace_me
BOT_USERNAME=replace_me_bot
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/anonymous_bot
SUPERADMIN_IDS=123456789
CHANNEL_ID=-1001234567890
MODERATION_CHAT_ID=-1001234567891
DISCUSSION_CHAT_ID=-1001234567892

# Railway'da RAILWAY_PUBLIC_DOMAIN avtomatik ishlatiladi.
# Boshqa hostingda: WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_a_long_random_value

APP_MODE=webhook
LOG_LEVEL=INFO
RATE_LIMIT_SECONDS=20
SESSION_TTL_MINUTES=30

