BOT_TOKEN=123456789:replace_me
BOT_USERNAME=replace_me_bot
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/anonymous_bot
SUPERADMIN_IDS=123456789
CHANNEL_ID=-1001234567890
MODERATION_CHAT_ID=-1001234567891
DISCUSSION_CHAT_ID=-1001234567892

# Railway'da RAILWAY_PUBLIC_DOMAIN avtomatik ishlatiladi.
# Boshqa hostingda: WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_at_least_32_random_chars

APP_MODE=webhook
LOG_LEVEL=INFO
RATE_LIMIT_SECONDS=20
SESSION_TTL_MINUTES=30
WEBHOOK_MAX_CONNECTIONS=10
MAX_WEBHOOK_BODY_BYTES=1000000
USER_UPDATE_LIMIT=30
GLOBAL_UPDATE_LIMIT=600
RATE_LIMIT_WINDOW_SECONDS=60
IDENTITY_RETENTION_DAYS=90
REJECTED_CONTENT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
PROCESSED_UPDATE_RETENTION_DAYS=7
